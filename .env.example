# Sunucuda bunu .env olarak kopyala ve degerleri doldur. .env dosyasini ASLA commit etme.
GITHUB_OWNER=vedatkoylahisar
TAG=latest
POSTGRES_PASSWORD=degistir
JWT_KEY=en-az-32-karakterlik-uzun-rastgele-bir-anahtar
ADMIN_USERNAME=admin
ADMIN_PASSWORD=degistir
# Frontend'in gercekten yayinda olacagi adres(ler), virgulle ayrilmis. Bos/yanlis birakirsan
# tarayici CORS hatasi alir - "http://localhost:3000" degil, gercek alan adin/IP'in olmali.
CORS_ALLOWED_ORIGINS=http://your-domain-or-ip
